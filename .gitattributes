# Normalize line endings: LF in the repo and in the working tree, on every OS.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Explicit text types (LF)
*.md        text eol=lf
*.kcm       text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.pro       text eol=lf
gradlew     text eol=lf

# Binary files: never touch.
*.jar   binary
*.apk   binary
*.aab   binary
*.keystore binary
*.jks   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
